{
  "dependencies": {
    "@hyper-elements/react": "^0.4.6",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.33.5"
  },
  "description": "ADOPSI — Hyper Elements Adoption Kit: one audit file → audit email, onboarding email, adoption roadmap page, migration guide PDF, readiness certificate, cheat-sheet card and announcement card. Entry for the Unlayer Hyper Elements Template Challenge.",
  "devDependencies": {
    "@hyper-elements/cli": "^0.2.10",
    "@hyper-elements/email-clients": "^0.4.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "name": "adopsi-kit",
  "private": true,
  "scripts": {
    "check": "hyper-elements check src",
    "demo": "tsx scripts/build-demo.tsx",
    "gate": "tsx scripts/gate.tsx",
    "render": "hyper-elements render src --out out",
    "test": "tsx --test tests/scoring.test.ts tests/second-audit.test.ts tests/demo.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "hyper-elements preview src/AuditEmail.tsx src/OnboardingEmail.tsx --clients outlook,outlook-com,gmail,gmail-app,apple-mail,yahoo,aol --out out"
  },
  "type": "module",
  "version": "1.0.0"
}
